
include rose-pine.conf
font_size 12
# font_family Iosevka Term Extended
window_margin_width 0
remember_window_size no
background_opacity 0.85


# BEGIN_KITTY_FONTS
font_family      family='JetBrains Mono' style=Medium
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
